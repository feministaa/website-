# Password required to sign in to /admin. Copy this file to .env.local and change it.
ADMIN_PASSWORD=feminista180

# Public site URL, used for canonical links, Open Graph tags and the sitemap.
# Set this to your production domain when you deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret — server-only, bypasses Row Level Security. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — Dashboard → Settings → API Keys. Server-only, never expose the secret to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# iThink Logistics — Settings → API Key. Server-only, never expose the secret to the browser.
ITHINK_ACCESS_TOKEN=
ITHINK_SECRET_KEY=
ITHINK_WAREHOUSE_ID=
